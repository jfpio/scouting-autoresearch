---
interface Props {
  locale?: 'pl' | 'en';
}

const { locale = 'pl' } = Astro.props;
const isPl = locale === 'pl';
const explorerPath = `/scouting-autoresearch/semantic-map/${locale}/`;
const labels = isPl
  ? {
      title: 'Interaktywna mapa semantyczna 914 gier',
      description: 'Dwupoziomowa mapa Amber: osiem regionów i trzydzieści dwa podregiony. Położenie służy nawigacji, a nie klasyfikacji historycznej.',
      open: 'Otwórz pełną mapę',
      loading: 'Ładowanie interaktywnej mapy semantycznej',
      fallback: 'Otwórz mapę w osobnej stronie, aby skorzystać z wyszukiwania, drzewa tematów i dostępnej listy tekstowej.',
    }
  : {
      title: 'Interactive semantic map of 914 games',
      description: 'A two-level Amber map with eight regions and thirty-two subregions. Position is navigational, not a historical classification.',
      open: 'Open the full map',
      loading: 'Loading the interactive semantic map',
      fallback: 'Open the separate map page to use search, the topic tree, and the accessible text list.',
    };
---

<section class="semantic-map not-content" data-semantic-map-preview>
  <div class="map-heading">
    <div>
      <h2>{labels.title}</h2>
      <p>{labels.description}</p>
    </div>
    <a class="full-map-link" href={explorerPath}>{labels.open} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="map-frame-shell">
    <iframe
      src={explorerPath}
      title={labels.title}
      loading="lazy"
      allowfullscreen
      data-semantic-map-frame
    >{labels.loading}</iframe>
  </div>
  <noscript><p><a href={explorerPath}>{labels.fallback}</a></p></noscript>
</section>

<style>
  .semantic-map {
    margin-top: 1.25rem;
  }
  .map-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: .8rem;
    padding: .9rem 1rem;
    border: 1px solid var(--rule);
    border-radius: .85rem;
    background: var(--paper-deep);
  }
  .map-heading h2 {
    margin: 0;
    color: var(--ink);
    font-size: 1.1rem;
  }
  .map-heading p {
    max-width: 56rem;
    margin: .35rem 0 0;
    color: var(--muted);
    font-size: .86rem;
  }
  .full-map-link {
    flex: none;
    display: inline-flex;
    gap: .35rem;
    align-items: center;
    min-height: 2.6rem;
    padding: .5rem .85rem;
    border: 1px solid var(--rule);
    border-radius: .55rem;
    background: var(--paper);
    color: var(--ink);
    font-size: .84rem;
    font-weight: 800;
    text-decoration: none;
  }
  .full-map-link:hover,
  .full-map-link:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }
  .map-frame-shell {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: .9rem;
    background: #0b1016;
  }
  iframe {
    display: block;
    width: 100%;
    height: min(72vh, 50rem);
    min-height: 32rem;
    border: 0;
    background: #0b1016;
  }
  @media (max-width: 48rem) {
    .map-heading {
      align-items: stretch;
      flex-direction: column;
    }
    .full-map-link {
      justify-content: center;
    }
    iframe {
      height: 70vh;
      min-height: 26rem;
    }
  }
</style>
