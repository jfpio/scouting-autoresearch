---
import activitiesPl from '../../data/generated/activities.pl.json';
import activitiesEn from '../../data/generated/activities.en.json';

interface Props {
  locale?: 'pl' | 'en';
  kind?: 'game' | 'trial' | 'scout-course';
}

const { locale = 'pl', kind } = Astro.props;
const all = locale === 'en' ? activitiesEn : activitiesPl;
const activities = kind ? all.filter((item) => item.kinds.includes(kind)) : all;
const isPl = locale === 'pl';
const options = (key) => [...new Set(activities.map((item) => item[key]).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b), locale));
const authors = options('author');
const books = options('sourceTitle');
const years = options('year');
const traits = [...new Set(activities.flatMap((item) => item.filterTraits))].sort((a, b) => a.localeCompare(b, locale));
const searchableText = (item) => [item.title, item.body, ...item.traits, ...item.filterTraits, item.author, item.sourceTitle].filter(Boolean).join(' ');
const basePath = locale === 'en' ? '/scouting-autoresearch/en/activities/' : '/scouting-autoresearch/activities/';
const labels = isPl
  ? {
      search: 'Szukaj w tytule, treści i cechach', placeholder: 'np. ogień, tropienie, cierpliwość',
      kind: 'Rodzaj', game: 'Gra', trial: 'Próba', 'scout-course': 'Bieg harcerski',
      trait: 'Cecha', author: 'Autor', book: 'Książka', year: 'Rok',
      choose: 'Wybierz', selected: 'wybrano', clear: 'Wyczyść filtry', remove: 'Usuń filtr',
      results: 'aktywności', noResults: 'Brak aktywności pasujących do filtrów.',
      machine: 'Tłumaczenie automatyczne', original: 'Tekst źródłowy', read: 'Czytaj',
    }
  : {
      search: 'Search titles, text, and traits', placeholder: 'e.g. fire, tracking, patience',
      kind: 'Type', game: 'Game', trial: 'Trial', 'scout-course': 'Scout course',
      trait: 'Trait', author: 'Author', book: 'Book', year: 'Year',
      choose: 'Choose', selected: 'selected', clear: 'Clear filters', remove: 'Remove filter',
      results: 'activities', noResults: 'No activities match these filters.',
      machine: 'Automatic translation', original: 'Source text', read: 'Read',
    };
const kindLabel = (value) => labels[value] || value;
const kinds = [...new Set(activities.flatMap((item) => item.kinds))].sort((a, b) => kindLabel(a).localeCompare(kindLabel(b), locale));
const facetLabels = { kind: labels.kind, trait: labels.trait, author: labels.author, book: labels.book, year: labels.year };
---

<section
  class="activity-explorer not-content"
  data-explorer
  data-locale={locale}
  data-facet-labels={JSON.stringify(facetLabels)}
  data-remove-label={labels.remove}
>
  <div class="filter-panel">
    <div class="filter-toolbar">
      <label class="search-field">
        <span>{labels.search}</span>
        <input type="search" data-query placeholder={labels.placeholder} autocomplete="off" />
      </label>
      <button type="button" class="clear-filters" data-clear>{labels.clear}</button>
    </div>
    <button class="filter-toggle" type="button" data-toggle-filters aria-expanded="false" aria-controls="catalog-filters">{isPl ? 'Filtry' : 'Filters'} <span data-filter-total>0</span> <span aria-hidden="true">⌄</span></button>
    <div class="filter-grid" id="catalog-filters">
      {!kind && (
        <details class="multi-filter" data-filter-menu="kind">
          <summary><span>{labels.kind}</span><span class="selection-count" data-selection-count>{labels.choose}</span></summary>
          <div class="filter-options" role="group" aria-label={labels.kind}>
            {kinds.map((value) => <label><input type="checkbox" data-filter="kind" value={value} /><span>{kindLabel(value)}</span></label>)}
          </div>
        </details>
      )}
      {kind === 'trial' && (
        <details class="multi-filter" data-filter-menu="trait">
          <summary><span>{labels.trait}</span><span class="selection-count" data-selection-count>{labels.choose}</span></summary>
          <div class="filter-options filter-options-long" role="group" aria-label={labels.trait}>
            {traits.map((value) => <label><input type="checkbox" data-filter="trait" value={value} /><span>{value}</span></label>)}
          </div>
        </details>
      )}
      <details class="multi-filter" data-filter-menu="author">
        <summary><span>{labels.author}</span><span class="selection-count" data-selection-count>{labels.choose}</span></summary>
        <div class="filter-options" role="group" aria-label={labels.author}>
          {authors.map((value) => <label><input type="checkbox" data-filter="author" value={value} /><span>{value}</span></label>)}
        </div>
      </details>
      <details class="multi-filter" data-filter-menu="book">
        <summary><span>{labels.book}</span><span class="selection-count" data-selection-count>{labels.choose}</span></summary>
        <div class="filter-options filter-options-long" role="group" aria-label={labels.book}>
          {books.map((value) => <label><input type="checkbox" data-filter="book" value={value} /><span>{value}</span></label>)}
        </div>
      </details>
      <details class="multi-filter" data-filter-menu="year">
        <summary><span>{labels.year}</span><span class="selection-count" data-selection-count>{labels.choose}</span></summary>
        <div class="filter-options" role="group" aria-label={labels.year}>
          {years.map((value) => <label><input type="checkbox" data-filter="year" value={String(value)} /><span>{value}</span></label>)}
        </div>
      </details>
    </div>
    <div class="selected-filters" data-selected-filters hidden aria-live="polite"></div>
  </div>

  <div class="results-heading" aria-live="polite"><strong><span data-count>{activities.length}</span> {labels.results}</strong></div>
  <div class="activity-grid" data-grid>
    {activities.map((item) => (
      <article
        class="activity-card"
        data-card
        data-search={searchableText(item)}
        data-kinds={JSON.stringify(item.kinds)}
        data-traits={JSON.stringify(item.filterTraits)}
        data-author={JSON.stringify([item.author])}
        data-book={JSON.stringify([item.sourceTitle])}
        data-year={JSON.stringify([String(item.year)])}
      >
        <div class="card-topline">
          <span class={`kind-badge kind-${item.kinds[0]}`}>{item.kinds.map(kindLabel).join(' · ')}</span>
          <span class="activity-id">{item.id}</span>
        </div>
        <h2><a href={`${basePath}${item.id}/`}>{item.title}</a></h2>
        {item.filterTraits.length > 0 && <ul class="trait-list">{item.filterTraits.slice(0, 5).map((trait) => <li>{trait}</li>)}</ul>}
        <p class="card-preview">{item.summary}</p>
        <p class="source-line"><strong>{item.author}</strong> · <cite>{item.sourceTitle}</cite> · {item.year}</p>
        <div class="card-footer">
          <span>{item.translationStatus === 'machine-translation' ? labels.machine : labels.original}</span>
          <a href={`${basePath}${item.id}/`}>{labels.read} →</a>
        </div>
      </article>
    ))}
  </div>
  <p class="no-results" data-empty hidden>{labels.noResults}</p>
</section>

<script>
  const normalize = (value) => value.toLocaleLowerCase('pl').normalize('NFKD').replace(/\p{Diacritic}/gu, '');
  const decodeValues = (card, key) => JSON.parse(card.dataset[key] || '[]');

  document.querySelectorAll('[data-explorer]').forEach((explorer) => {
    const query = explorer.querySelector('[data-query]');
    const checkboxes = [...explorer.querySelectorAll('input[type="checkbox"][data-filter]')];
    const cards = [...explorer.querySelectorAll('[data-card]')];
    const count = explorer.querySelector('[data-count]');
    const empty = explorer.querySelector('[data-empty]');
    const chips = explorer.querySelector('[data-selected-filters]');
    const clear = explorer.querySelector('[data-clear]');
    const filterToggle = explorer.querySelector('[data-toggle-filters]');
    const filterTotal = explorer.querySelector('[data-filter-total]');
    filterToggle.addEventListener('click', () => {
      const expanded = filterToggle.getAttribute('aria-expanded') !== 'true';
      filterToggle.setAttribute('aria-expanded', String(expanded));
      explorer.toggleAttribute('data-filters-open', expanded);
    });
    const facetLabels = JSON.parse(explorer.dataset.facetLabels || '{}');
    const removeLabel = explorer.dataset.removeLabel || 'Remove filter';
    const selectedLabel = explorer.dataset.locale === 'pl' ? 'wybrano' : 'selected';
    const chooseLabel = explorer.dataset.locale === 'pl' ? 'Wybierz' : 'Choose';

    const selectedValues = () => {
      const values = {};
      checkboxes.filter((input) => input.checked).forEach((input) => {
        (values[input.dataset.filter] ||= []).push(input.value);
      });
      return values;
    };

    const optionLabel = (input) => input.parentElement?.querySelector('span')?.textContent || input.value;

    const renderSelections = (values) => {
      filterTotal.textContent = String(checkboxes.filter(input => input.checked).length);
      chips.replaceChildren();
      checkboxes.filter((input) => input.checked).forEach((input) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'filter-chip';
        button.dataset.removeFilter = input.dataset.filter;
        button.dataset.removeValue = input.value;
        button.setAttribute('aria-label', `${removeLabel}: ${facetLabels[input.dataset.filter]} ${optionLabel(input)}`);
        button.append(document.createTextNode(`${facetLabels[input.dataset.filter]}: ${optionLabel(input)} `));
        const mark = document.createElement('span');
        mark.setAttribute('aria-hidden', 'true');
        mark.textContent = '×';
        button.append(mark);
        chips.append(button);
      });
      chips.hidden = chips.childElementCount === 0;
      explorer.querySelectorAll('[data-filter-menu]').forEach((menu) => {
        const facet = menu.dataset.filterMenu;
        const total = values[facet]?.length || 0;
        menu.querySelector('[data-selection-count]').textContent = total ? `${total} ${selectedLabel}` : chooseLabel;
      });
    };

    const apply = ({ updateUrl = true } = {}) => {
      const values = selectedValues();
      const needle = normalize(query.value || '');
      let visible = 0;
      cards.forEach((card) => {
        const matchesQuery = !needle || normalize(card.dataset.search || '').includes(needle);
        const matchesFacets = Object.entries(values).every(([facet, wanted]) => {
          const dataKey = facet === 'trait' ? 'traits' : facet === 'kind' ? 'kinds' : facet;
          const actual = decodeValues(card, dataKey);
          return wanted.some((value) => actual.includes(value));
        });
        const matches = matchesQuery && matchesFacets;
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      count.textContent = String(visible);
      empty.hidden = visible !== 0;
      clear.disabled = !query.value && checkboxes.every((input) => !input.checked);
      renderSelections(values);
      if (updateUrl) {
        const params = new URLSearchParams();
        if (query.value) params.set('query', query.value);
        Object.entries(values).forEach(([facet, selected]) => selected.forEach((value) => params.append(facet, value)));
        history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
      }
    };

    const restoreFromUrl = () => {
      const params = new URLSearchParams(location.search);
      query.value = params.get('query') || '';
      checkboxes.forEach((input) => { input.checked = params.getAll(input.dataset.filter).includes(input.value); });
      apply({ updateUrl: false });
    };

    query.addEventListener('input', () => apply());
    checkboxes.forEach((input) => input.addEventListener('change', () => apply()));
    clear.addEventListener('click', () => {
      query.value = '';
      checkboxes.forEach((input) => { input.checked = false; });
      apply();
    });
    chips.addEventListener('click', (event) => {
      const button = event.target.closest('[data-remove-filter]');
      if (!button) return;
      const input = checkboxes.find((candidate) => candidate.dataset.filter === button.dataset.removeFilter && candidate.value === button.dataset.removeValue);
      if (input) input.checked = false;
      apply();
    });
    explorer.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        explorer.querySelectorAll('details[open]').forEach((menu) => menu.removeAttribute('open'));
        if (matchMedia('(max-width: 767px)').matches && explorer.hasAttribute('data-filters-open')) {
          explorer.removeAttribute('data-filters-open');
          filterToggle.setAttribute('aria-expanded', 'false');
          filterToggle.focus();
        }
      }
    });
    window.addEventListener('popstate', restoreFromUrl);
    restoreFromUrl();
  });
</script>
